# "mock" (padrão) usa dados em memória, sem precisar configurar nada.
# "supabase" passa a usar o banco real — preencha as três variáveis abaixo.
#
# Integração ao monorepo (2026-07-25): usar o Supabase PRINCIPAL do sistema
# (mesmo projeto do painel/API); as tabelas do CRM vivem no schema `whatsapp`
# (migrations 0000..0012). Não esquecer de expor o schema em Settings → API →
# Exposed schemas.
NEXT_PUBLIC_DATA_SOURCE=mock

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Usada só no servidor (dados + webhook + crons). NUNCA prefixar com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# "mock" (padrão) simula o WhatsApp direto no painel, sem nenhuma credencial da
# Meta (use o formulário de simulação em /conversas). "cloud-api" liga a
# integração real — preencha as 5 variáveis abaixo e configure o webhook no
# painel da Meta (ver README.md).
WHATSAPP_PROVIDER=mock

WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Necessária para os recursos de IA (resumo de conversa e sugestão de
# follow-up, na ficha do contato). Sem essa variável, os botões de IA mostram
# um erro amigável pedindo para configurá-la — o resto do painel funciona
# normalmente. Gere uma chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado pelos recursos de IA. Opcional — o padrão é claude-sonnet-5
# (equilíbrio custo/qualidade). Troque para claude-opus-4-8 (mais caro/melhor)
# ou claude-haiku-4-5 (mais barato/rápido) sem mexer no código.
AI_MODEL=

# Integração com a API principal do back-office (FastAPI). Liga o CRM ao
# domínio real: um código de imóvel citado numa conversa resolve o imóvel de
# verdade (título/bairro/status/preço) do catálogo. Server-to-server via header
# X-Internal-Token — mesmo padrão das captações. Sem essas variáveis, o vínculo
# de imóvel por código ainda funciona, só sem os dados ricos. O token é o mesmo
# INTERNAL_API_TOKEN configurado na API.
BACKOFFICE_API_URL=https://api.morabilidade.com
BACKOFFICE_INTERNAL_TOKEN=

# Notificação push (celular/desktop) quando chega mensagem no WhatsApp — mock
# ou real. Opcional: sem essas variáveis, o item "Ativar notificações" some do
# menu do usuário e o resto do painel funciona normalmente. Gere o par com:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Jobs de hora em hora (Fase 3 do roadmap de follow-up: esfriamento e alerta) e
# o resumo diário (Fase 4). ALERT_PHONE_NUMBER é o seu número (formato
# 55DDDNNNNNNNNN) — é pra onde vão os alertas e o resumo. CRON_SECRET protege
# as rotas /api/cron/*: a Vercel manda esse valor sozinha em
# "Authorization: Bearer $CRON_SECRET" quando a env var está configurada no
# projeto (ver README.md para testar localmente com curl).
ALERT_PHONE_NUMBER=
CRON_SECRET=

# Templates aprovados na Meta (opcionais, mas necessários fora da janela de 24h).
# WHATSAPP_ALERT_TEMPLATE: corpo com um único {{1}} — usado nos alertas
# operacionais e nas pendências enviadas ao plantão.
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE_LANG=pt_BR

# Ficha de visita automática (/api/cron/visita-fichas, de hora em hora):
# 1h antes de cada visita agendada, o CRM gera a ficha na API principal e manda
# o link de assinatura pro cliente. Fora da janela de 24h, tenta o template
# WHATSAPP_FICHA_TEMPLATE (dois parâmetros: {{1}} hora, {{2}} link); se também
# não der, a pendência vai pros números de plantão.
#
# PENDING_PHONE_NUMBERS: 1 ou 2 números (55DDDNNNNNNNNN) separados por vírgula
# que concentram as pendências de envio. Vazio = cai no ALERT_PHONE_NUMBER.
# NEXT_PUBLIC_SITE_URL: base do site público, onde mora /ficha/<token>.
PENDING_PHONE_NUMBERS=
NEXT_PUBLIC_SITE_URL=https://morabilidade.com
WHATSAPP_FICHA_TEMPLATE=
WHATSAPP_FICHA_TEMPLATE_LANG=pt_BR

# Board de captações (app irmão captacoes/): link "Abrir board" no painel do
# copiloto dentro da conversa. Opcional — sem ele, o link simplesmente some.
CAPTACOES_BOARD_URL=https://captacoes.morabilidade.com
